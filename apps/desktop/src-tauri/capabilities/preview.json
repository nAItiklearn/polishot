{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "preview",
  "description": "Main preview/editor window: capture results, OCR, history, settings, license, export.",
  "windows": [
    "preview"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-capture-start",
    "allow-ocr-recognize",
    "allow-open-file",
    "allow-paste-clipboard-image",
    "allow-export-save",
    "allow-copy-image",
    "allow-copy-text",
    "allow-share-file",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "allow-history-list",
    "allow-history-get",
    "allow-history-save",
    "allow-history-delete",
    "allow-history-clear",
    "allow-settings-get",
    "allow-settings-set",
    "allow-license-status",
    "allow-license-activate",
    "allow-license-deactivate",
    "allow-pin-open",
    "allow-app-info",
    "allow-qs-devices",
    "allow-qs-pairing-mode",
    "allow-qs-pair-start",
    "allow-qs-pair-confirm",
    "allow-qs-send",
    "allow-qs-forget",
    "allow-qs-incoming-respond"
  ]
}
