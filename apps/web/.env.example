# Where the "Buy a license" button points. Leave empty until licenses are on sale:
# the pricing page then shows a disabled "On sale soon" button. Must be an https:// URL.
NEXT_PUBLIC_CHECKOUT_URL=

# Public https base URL the release files are uploaded to (the source repo is private). The download page
# links to <base>/Polishot-Setup-x64.exe and so on. Empty = "not released yet", with no links at all.
NEXT_PUBLIC_DOWNLOAD_BASE_URL=

# Contact address shown on the privacy and terms pages. Empty = "will be listed before the first release".
NEXT_PUBLIC_SUPPORT_EMAIL=

# Public origin of the site, used for canonical URLs, the sitemap and social cards.
# Empty falls back to SITE_URL from @polishot/brand.
NEXT_PUBLIC_SITE_URL=

# Anonymous visitor counter (the small "N visitors" pill in the header). Optional: if any of these three is
# empty the pill is not rendered and /api/visits answers 404.
# Create a free Upstash Redis database and copy its REST URL and token. VISITOR_SALT is any long random
# string you keep secret; it makes the stored hashes impossible to reverse by guessing IP addresses.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VISITOR_SALT=
