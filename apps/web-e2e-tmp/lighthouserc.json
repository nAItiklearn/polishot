{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start --port 3108",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3108/",
        "http://localhost:3108/features",
        "http://localhost:3108/pricing",
        "http://localhost:3108/changelog",
        "http://localhost:3108/download",
        "http://localhost:3108/privacy",
        "http://localhost:3108/terms"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./test-results/lhci"
    }
  }
}
