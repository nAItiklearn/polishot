    <!-- Overlay permission explanation -->
    <string name="overlay_header">Floating button</string>
    <string name="overlay_title">Show the capture button over other apps?</string>
    <string name="overlay_body">Polishot draws one small button on top of whatever you are looking at. Tap it and the screen is captured, then opened for editing. Android calls this permission Display over other apps.</string>
    <string name="overlay_promise">The button can\'t read other apps or your screen. It only receives the single frame you ask for, and everything stays on this device.</string>
